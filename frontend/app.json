{
  "expo": {
    "name": "Frontend",
    "slug": "Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "techshield",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1326",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#0b1326",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "TechShield — Marketplace Verificado",
      "shortName": "TechShield",
      "description": "Compra y venta de hardware y móviles verificados con custodia (escrow), auditoría técnica y garantía TechShield.",
      "lang": "es",
      "themeColor": "#0b1326",
      "backgroundColor": "#0b1326",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "orientation": "portrait",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0b1326"
      }
    },
"plugins": [
      "expo-secure-store",
      "expo-asset",
      ["expo-router", { "asyncRoutes": "production" }]
    ]
  }
}
