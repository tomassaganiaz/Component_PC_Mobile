# Database (local o nube)
# Para PostgreSQL en la nube (Neon/Supabase/Railway) usá la URL y activá SSL:
DATABASE_URL=postgresql://user:pass@host/pg/dbname?sslmode=require
DATABASE_SSL=true
# O por partes (local):
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=ers_components

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_minimum_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# App
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=*

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mercado Libre (integración de ventas). Si faltan, corre en modo demo (mock).
# Crear app en https://developers.mercadolibre.com.ar/ y copiar las credenciales.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_SITE=MLA
ML_REDIRECT_URI=http://localhost:3000/api/mercadolibre/callback

